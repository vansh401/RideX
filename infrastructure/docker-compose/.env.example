POSTGRES_DB=ridex_db
POSTGRES_USER=ridex
POSTGRES_PASSWORD=ridex_local_pass
# ---- optional: only for `docker compose up` of the whole system ----
# First admin account of the core (created only if no admin exists). Put real values in your own .env, which git ignores.
# ADMIN_EMAIL=
# ADMIN_PASSWORD=
# Tag of the images you build (ridex/core:dev ...)
# RIDEX_TAG=dev

# ---- Phase 15: real email and real online payments (both optional and both free). See docs/payments-and-email-setup.md ----
# Email: leave unset to use Mailpit. Gmail example (create an "app password" in your Google account, 2-step verification must be on):
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USERNAME=you@gmail.com
# MAIL_AUTH=true
# MAIL_STARTTLS=true
# MAIL_FROM=you@gmail.com
#   ... and put the app password (only) into secrets/MAIL_PASSWORD
# Online payments: Razorpay TEST key id (starts with rzp_test_); the secret goes into secrets/RAZORPAY_KEY_SECRET
# RAZORPAY_KEY_ID=
# Where the website is reachable (links in emails)
# FRONTEND_URL=http://localhost:3000

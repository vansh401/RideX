POSTGRES_DB=ridex_db
POSTGRES_USER=ridex
POSTGRES_PASSWORD=ridex_local_pass
# ---- optional: only for `docker compose up` of the whole system ----
# First admin account of the core (created only if no admin exists). Put real values in your own .env, which git ignores.
# ADMIN_EMAIL=
# ADMIN_PASSWORD=
# Tag of the images you build (ridex/core:dev ...)
# RIDEX_TAG=dev
